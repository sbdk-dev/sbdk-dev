{
  "name": "SBDK AgentDB - Memory and Learning System",
  "version": "1.0.0",
  "database": {
    "type": "agentdb",
    "location": ".sbdk/agentdb",
    "collections": [
      {
        "name": "phase_memories",
        "description": "Learnings and insights from each development phase",
        "schema": {
          "phase": "string",
          "date": "datetime",
          "component": "string",
          "learnings": "array",
          "metrics": "object",
          "decisions": "array"
        },
        "indexes": ["phase", "component", "date"]
      },
      {
        "name": "agent_interactions",
        "description": "Record of agent interactions and collaboration patterns",
        "schema": {
          "agent_id": "string",
          "task": "string",
          "timestamp": "datetime",
          "duration": "number",
          "outcome": "string",
          "collaboration": "array"
        },
        "indexes": ["agent_id", "task", "timestamp"]
      },
      {
        "name": "code_patterns",
        "description": "Successful code patterns and anti-patterns",
        "schema": {
          "pattern_name": "string",
          "category": "string",
          "code_example": "string",
          "use_cases": "array",
          "effectiveness": "number",
          "learned_from": "string"
        },
        "indexes": ["category", "effectiveness"]
      },
      {
        "name": "architecture_decisions",
        "description": "Architecture decisions and their rationale",
        "schema": {
          "decision_id": "string",
          "date": "datetime",
          "decision": "string",
          "rationale": "string",
          "alternatives": "array",
          "impact": "string",
          "phase": "string"
        },
        "indexes": ["phase", "date"]
      },
      {
        "name": "performance_baselines",
        "description": "Performance metrics and benchmarks",
        "schema": {
          "component": "string",
          "metric_name": "string",
          "value": "number",
          "unit": "string",
          "timestamp": "datetime",
          "context": "object"
        },
        "indexes": ["component", "metric_name"]
      },
      {
        "name": "semantic_models",
        "description": "Semantic layer models and usage patterns",
        "schema": {
          "model_name": "string",
          "definition": "object",
          "usage_count": "number",
          "queries": "array",
          "effectiveness": "number"
        },
        "indexes": ["model_name", "usage_count"]
      }
    ]
  },
  "memory_config": {
    "retention": {
      "phase_memories": "permanent",
      "agent_interactions": "1_year",
      "code_patterns": "permanent",
      "architecture_decisions": "permanent",
      "performance_baselines": "6_months",
      "semantic_models": "permanent"
    },
    "embeddings": {
      "enabled": true,
      "model": "claude-3-sonnet",
      "dimensions": 1024,
      "similarity_threshold": 0.85
    },
    "retrieval": {
      "max_results": 10,
      "relevance_boost": 1.5,
      "recency_decay": 0.95
    }
  },
  "learning": {
    "auto_learn": true,
    "patterns": {
      "min_occurrences": 3,
      "confidence_threshold": 0.8
    },
    "feedback_loop": {
      "enabled": true,
      "update_frequency": "on_completion"
    }
  },
  "initialization": {
    "load_from_files": [
      ".claude/memory.json",
      "PHASE_1_COMPLETION_REPORT.md"
    ],
    "import_learnings": true,
    "import_metrics": true,
    "import_decisions": true
  },
  "phase_2_memory_structure": {
    "load_phase_1": {
      "components": [
        "incremental_processing",
        "quality_framework",
        "testing_framework",
        "error_handling",
        "hot_reload"
      ],
      "learnings": [
        "Multi-agent parallel development is highly effective",
        "TDD with high coverage ensures quality",
        "Comprehensive documentation prevents knowledge loss",
        "Separation of concerns enables independent development"
      ],
      "patterns": [
        "Pydantic for configuration",
        "Separate state management",
        "YAML support for rules",
        "Custom pytest assertions",
        "Debouncing for file watchers"
      ]
    },
    "track_phase_2": {
      "focus_areas": [
        "Multi-environment patterns",
        "Semantic layer design",
        "AI integration approaches",
        "Agent collaboration patterns",
        "Cross-component integration"
      ],
      "metrics_to_track": [
        "environment_switch_time",
        "semantic_query_latency",
        "ai_suggestion_accuracy",
        "agent_coordination_efficiency",
        "test_coverage"
      ]
    }
  }
}
