# ============================================================================
# SBDK Development - .gitignore
# ============================================================================

# ----------------------------------------------------------------------------
# Python
# ----------------------------------------------------------------------------

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-wheel-metadata/

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/
test_results/
test-results/
test_output/
.test_cache/

# Translations
*.mo
*.pot

# Django/Flask
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
instance/
.webassets-cache

# Scrapy
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# Environments
.env
.env.*
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# Ruff
.ruff_cache/

# ----------------------------------------------------------------------------
# IDEs and Editors
# ----------------------------------------------------------------------------

# VS Code
.vscode/
*.code-workspace

# PyCharm / IntelliJ
.idea/
*.iml
*.iws
*.ipr

# Eclipse
.project
.pydevproject
.settings/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Atom
.atom/

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# ----------------------------------------------------------------------------
# Operating Systems
# ----------------------------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# ----------------------------------------------------------------------------
# SBDK Specific
# ----------------------------------------------------------------------------

# Test projects
my_analytics_project/
sandbox_demo/
test-project/
temp_test/

# Development databases (not production schemas)
*.duckdb
*.duckdb.wal
*.duckdb-journal

# ----------------------------------------------------------------------------
# Claude Flow & Swarm (Temporary Session Files)
# ----------------------------------------------------------------------------
# NOTE: Documentation files like CLAUDE.md and CLAUDE_SWARM_BUILDER.md
# are NOT ignored - they are permanent documentation.

# Claude Flow runtime directories
.claude-flow/
.claude-flow-cache/
.claude-flow-sessions/

# Swarm runtime directories
.swarm/
.hive-mind/
coordination/

# Session and state files (temporary)
*.swarm
*.claude-flow-session
*.claude-flow-cache
swarm-memory-*.json
agent-state-*.json
coordination-log-*.txt
task-*.json
swarm_*
agent_*

# Claude Flow executables (generated)
claude-flow
claude-flow.bat
claude-flow.ps1

# Hive mind prompts (temporary)
hive-mind-prompt-*.txt

# MCP runtime config (generated)
.mcp.json
claude-flow.config.json

# Temporary session files (NOT documentation)
.claude.md

# Memory directories (runtime)
memory/

# ----------------------------------------------------------------------------
# Secrets & Credentials
# ----------------------------------------------------------------------------

.env
.env.*
!.env.example
secrets/
credentials/
*.pem
*.key
*.cert
*.p12

# ----------------------------------------------------------------------------
# Logs
# ----------------------------------------------------------------------------

*.log
*.log.*
logs/
.sbdk/logs/

# ----------------------------------------------------------------------------
# Databases (Development)
# ----------------------------------------------------------------------------

*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal

# ----------------------------------------------------------------------------
# Archives
# ----------------------------------------------------------------------------

*.zip
*.tar
*.tar.gz
*.rar
*.7z

# ----------------------------------------------------------------------------
# Temporary Files
# ----------------------------------------------------------------------------

*.tmp
*.temp
*.bak
*.backup
*.old

# ----------------------------------------------------------------------------
# Lock Files
# ----------------------------------------------------------------------------
# Keep package manager lock files, ignore others

*.lock
!package-lock.json
!yarn.lock
!Pipfile.lock
!poetry.lock
!pdm.lock
!uv.lock

# ----------------------------------------------------------------------------
# Git Submodules
# ----------------------------------------------------------------------------

# Wiki content (nested git repo)
wiki-content/.git
